<?xml version="1.0" standalone="yes"?>
<!--
  Anonymized sample export of a Business Central Purchase Order report.

  Structure: PEB Purchase Order (report id 12047977).
  All company names, vendor names, addresses, persons and internal references
  have been replaced with fictional values. Quantities, dates and line item
  structure are kept realistic.
-->
<ReportDataSet name="PEB Purchase Order" id="12047977" language="en-US" formatRegion="en-US">
  <BCReportInformation>
    <ReportMetadata>
      <ExtensionId>00000000-0000-0000-0000-000000000000</ExtensionId>
      <ExtensionName>SweBase</ExtensionName>
      <ExtensionPublisher>Example Publisher AB</ExtensionPublisher>
      <ExtensionVersion>28.1.0.0</ExtensionVersion>
      <ReportId>12047977</ReportId>
      <ReportName>PEB Purchase Order</ReportName>
      <AboutThisReportTitle></AboutThisReportTitle>
      <AboutThisReportText></AboutThisReportText>
      <ReportHelpLink>https://docs.example.com/</ReportHelpLink>
    </ReportMetadata>
    <ReportRequest>
      <TenantEntraId>00000000-0000-0000-0000-000000000001</TenantEntraId>
      <EnvironmentName>Sandbox</EnvironmentName>
      <EnvironmentType>Sandbox</EnvironmentType>
      <CompanyName>DEMO</CompanyName>
      <CompanyDisplayName>Demo Logistics AB</CompanyDisplayName>
      <CompanyId>00000000-0000-0000-0000-000000000002</CompanyId>
      <UserName>test.user@example.com</UserName>
      <DateAndTime>2026-06-01 09:00:00</DateAndTime>
      <Language>en-US</Language>
      <FormatRegion>en-US</FormatRegion>
      <DateTimeValues>
        <Year>2026</Year>
        <MonthNumber>6</MonthNumber>
        <DayNumber>1</DayNumber>
        <Hour>9</Hour>
        <Minute>0</Minute>
      </DateTimeValues>
    </ReportRequest>
  </BCReportInformation>
  <DataItems>
    <!--
      Purchase_Header: one DataItem per purchase order.
      systemId  — stable GUID used as external_id in SCM (never changes).
    -->
    <DataItem language="en-US" formatRegion="en-US" name="Purchase_Header" tableId="38" systemId="aaaaaaaa-0001-0001-0001-000000000001">
      <DataItems>
        <!--
          CopyLoop: rendered once per document copy.
          Contains the printable header columns and all line DataItems.

          Named columns added here (Vendor_No, Vendor_Name, Order_Date,
          Expected_Receipt_Date) correspond to the equivalent BC header fields
          and are used by the SCM XML parser as the primary source for these
          values.
        -->
        <DataItem name="CopyLoop" tableId="2000000026">
          <Columns>
            <!-- System line identifier prefix for this document -->
            <Column name="Header01">10000100000000000000000001</Column>
            <!-- Order number surfaced in the email body by BC -->
            <Column name="EmailBodyTextLine4">Order No.: PO-2026-001</Column>
            <!-- Amount line used to derive currency when no explicit column exists -->
            <Column name="EmailBodyTextLine5">Amount: 10 650,00 USD excl. VAT</Column>
            <!-- Vendor master fields -->
            <Column name="Vendor_No">SUPP-0001</Column>
            <Column name="Vendor_Name">Anon Supplier Ltd</Column>
            <!-- Dates in ISO 8601 format -->
            <Column name="Order_Date">2026-03-15</Column>
            <Column name="Expected_Receipt_Date">2026-06-01</Column>
          </Columns>
          <DataItems>
            <!--
              TempPurchDocLine: one DataItem per printable line.
              IsTextLine=True  -> comment/header row, no item — parser skips these.
              IsTextLine=False -> real item line with Column01..Column07 data.

              Column mapping:
                Column01 = Item No. (item_no / SKU)
                Column02 = Description
                Column03 = Quantity (Swedish decimal: comma as separator)
                Column04 = Unit of Measure
                Column05 = Unit Price
                Column07 = Line Amount
                Line01   = BC line external ID (used as external_id in SCM)
            -->

            <!-- Text/comment line — parser must skip this -->
            <DataItem name="TempPurchDocLine">
              <Columns>
                <Column name="Line01">10000100000000000000010000</Column>
                <Column name="Column02">Spare Parts Order Q2 2026</Column>
                <Column name="IsTextLine">True</Column>
              </Columns>
            </DataItem>

            <!-- Item line 1: floor boards -->
            <DataItem name="TempPurchDocLine">
              <Columns>
                <Column name="Line01">10000100000000000000020000</Column>
                <Column name="Column01">ITM-4210</Column>
                <Column name="Column02">Container Floor Board 20ft</Column>
                <Column name="Column03">50</Column>
                <Column name="Column04">Pieces</Column>
                <Column name="Column05">120,00</Column>
                <Column name="Column07">6 000,00</Column>
                <Column name="IsTextLine">False</Column>
              </Columns>
            </DataItem>

            <!-- Item line 2: door seals -->
            <DataItem name="TempPurchDocLine">
              <Columns>
                <Column name="Line01">10000100000000000000030000</Column>
                <Column name="Column01">ITM-7830</Column>
                <Column name="Column02">Container Door Seal 40ft</Column>
                <Column name="Column03">100</Column>
                <Column name="Column04">Pieces</Column>
                <Column name="Column05">45,00</Column>
                <Column name="Column07">4 500,00</Column>
                <Column name="IsTextLine">False</Column>
              </Columns>
            </DataItem>

            <!-- Item line 3: twist locks (fractional qty uses comma decimal) -->
            <DataItem name="TempPurchDocLine">
              <Columns>
                <Column name="Line01">10000100000000000000040000</Column>
                <Column name="Column01">ITM-9010</Column>
                <Column name="Column02">Container Twist Lock Set</Column>
                <Column name="Column03">15,000</Column>
                <Column name="Column04">Sets</Column>
                <Column name="Column05">10,00</Column>
                <Column name="Column07">150,00</Column>
                <Column name="IsTextLine">False</Column>
              </Columns>
            </DataItem>

          </DataItems>
        </DataItem>
      </DataItems>
    </DataItem>
  </DataItems>
</ReportDataSet>
