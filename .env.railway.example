# Railway production environment variables
# Set these in the Railway dashboard under your service's Variables tab.
# Variables marked with (*) are required. Others are optional.

# --- Django core (*) ---
SECRET_KEY="generate-a-long-random-string"
ALLOWED_HOSTS="your-app.up.railway.app,yourdomain.com"
CSRF_TRUSTED_ORIGINS="https://your-app.up.railway.app,https://yourdomain.com"
CORS_ALLOWED_ORIGINS="https://your-app.up.railway.app,https://yourdomain.com"

# --- Database (*) ---
# Railway injects this automatically when you add a Postgres service and link it.
DATABASE_URL="postgresql://..."

# --- Redis (*) ---
# Railway injects this automatically when you add a Redis service and link it.
REDIS_URL="redis://..."

# --- SCM integration credentials (*) ---
# Fernet key used to encrypt integration credentials at rest. Mandatory in
# production: a system check fails the deploy without it, and since `migrate`
# runs system checks, the container exits before Gunicorn starts.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it stable — rotating it makes stored credentials unreadable.
SCM_INTEGRATION_ENCRYPTION_KEY=""

# --- Maps (supply chain visibility) ---
# Optional. Without a token the map card renders a configuration notice and the
# rest of the page keeps working. Only ever use a *public* (pk.) token here.
MAPBOX_PUBLIC_TOKEN=""
MAPBOX_STYLE_URL="mapbox://styles/mapbox/standard"

# --- Email ---
DEFAULT_FROM_EMAIL="noreply@yourdomain.com"
SERVER_EMAIL="noreply@yourdomain.com"
# EMAIL_BACKEND="anymail.backends.mailgun.EmailBackend"
# MAILGUN_API_KEY=""
# MAILGUN_SENDER_DOMAIN=""

# --- Analytics / Monitoring ---
GOOGLE_ANALYTICS_ID=""
SENTRY_DSN=""
SENTRY_ENVIRONMENT="production"  # or "staging"

# --- Social login ---
GOOGLE_CLIENT_ID=""
GOOGLE_SECRET_ID=""
TWITTER_CLIENT_ID=""
TWITTER_SECRET_ID=""
GITHUB_CLIENT_ID=""
GITHUB_SECRET_ID=""

# --- Turnstile (bot protection) ---
TURNSTILE_KEY=""
TURNSTILE_SECRET=""

# --- Stripe ---
STRIPE_LIVE_PUBLIC_KEY="pk_live_***"
STRIPE_LIVE_SECRET_KEY="sk_live_***"
STRIPE_TEST_PUBLIC_KEY="pk_test_***"
STRIPE_TEST_SECRET_KEY="sk_test_***"
STRIPE_PRICING_TABLE_ID="prctbl_***"

# --- S3 media storage ---
# Set USE_S3_MEDIA=True to store uploaded files in S3 instead of local disk.
# Required on Railway since the filesystem is ephemeral.
USE_S3_MEDIA=True
AWS_STORAGE_BUCKET_NAME=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# --- AI ---
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
DEFAULT_AI_MODEL="openai:gpt-4o-mini"

# --- Health check ---
HEALTH_CHECK_TOKENS=""
