CORS_ALLOWED_ORIGINS="http://localhost:5174,http://127.0.0.1:5174"

# Social login credentials go here

GOOGLE_CLIENT_ID=""
GOOGLE_SECRET_ID=""

TWITTER_CLIENT_ID=""
TWITTER_SECRET_ID=""

GITHUB_CLIENT_ID=""
GITHUB_SECRET_ID=""

# turnstile setup - add your keys here to enable turnstile
