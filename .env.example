# ── SCM carrier tracking ─────────────────────────────────────────────────────
# All of these have working defaults; set them only to override.
# Fernet key (url-safe base64, 32 bytes) encrypting stored integration credentials.
# Set an explicit, stable value in production so credentials survive a SECRET_KEY
# rotation. Never commit a real key.
# SCM_INTEGRATION_ENCRYPTION_KEY=""
# Max subscriptions queued per dispatcher tick (default 500).
# SCM_TRACKING_DISPATCH_LIMIT=500
# Days before a stored carrier response has its body archived away. The record,
# including its hash, is always kept. 0 disables archiving. (default 90)
# SCM_TRACKING_RAW_PAYLOAD_RETENTION_DAYS=90
# Days before a stored carrier response is deleted outright. 0 = never (default).
# SCM_TRACKING_RAW_PAYLOAD_DELETE_DAYS=0
# Set to False to pause the scheduled Business Central sync without removing the
# schedule or the implementation. Manual syncs are unaffected. (default True)
# SCM_BUSINESS_CENTRAL_DISPATCH_ENABLED=True

# ── SCM supply chain visibility (Mapbox) ─────────────────────────────────────
# Optional. Without a token the maps show a configuration notice and the rest of
# the visibility pages keep working.
# PUBLIC token only — it is rendered into the page. Never put a secret (sk.) token
# here. Restrict the production token to your own URLs in the Mapbox dashboard.
# MAPBOX_PUBLIC_TOKEN="pk.***"
# Override the base map style. (default mapbox://styles/mapbox/standard)
# MAPBOX_STYLE_URL="mapbox://styles/mapbox/standard"
